#!/usr/bin/env bash

set -euo pipefail

APP_DATA_DIR="$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/..")"

CHAIN_DIR="${APP_DATA_DIR}/data/chain"
ADMIN_DIR="${APP_DATA_DIR}/data/admin"
CONFIG_DIR="${ADMIN_DIR}/config"
KEYSTORE_DIR="${ADMIN_DIR}/keystore"
IDENTITY_DIR="${ADMIN_DIR}/identity"
LOG_DIR="${ADMIN_DIR}/logs"
ENV_FILE="${CONFIG_DIR}/node.env"

mkdir -p "${CHAIN_DIR}" "${CONFIG_DIR}" "${KEYSTORE_DIR}" "${IDENTITY_DIR}" "${LOG_DIR}"

if [[ ! -f "${ENV_FILE}" ]]; then
  cat >"${ENV_FILE}" <<'EOF'
APP_ALLFEAT_CHAIN=melodie
APP_ALLFEAT_NODE_NAME=allfeat-validator
# Optional: set APP_ALLFEAT_PUBLIC_ADDRESS to your VPS forwarded multiaddr.
# Example: /dns4/validator.example.com/tcp/30333
EOF
fi

chown -R 1000:1000 "${APP_DATA_DIR}/data"
